update(K = neighbors(c(1, 15)))
# Then create the grid
knn_grid2 <- grid_regular(knn_param, levels = 15) %>%
filter(K %% 2 == 1)
best_k2 <- tune_grid(
knn_workflow,
resamples = vfold_cv(train_ou, v = 10),
grid = knn_grid,
metrics = metric_set(yardstick::accuracy) # Ensure accuracy is included in metrics
) %>%
select_best(metric = "accuracy")
knn_workflow2_final <- finalize_workflow(knn_workflow, best_k) # Finalize workflow using best k
fit_knn2 <- fit(knn_workflow_final, data = train_ou)
predicted_results_knn2 <- predict(fit_knn, new_data = test_ou, type = "prob") %>%
pluck(2)
results_knn2 <- predicted_results_knn %>%
bind_cols(test_ou, predictedProbability = .) %>%
mutate(predictedClass = as.factor(ifelse(predictedProbability > 0.8, 1, 0)))
results_knn2 %>%
filter(status == "incomplete") %>%
select(timestamp,home_team_goal_count, away_team_goal_count)
results_knn2 %>%
select(home_team_name, away_team_name, Game.Week, predictedClass)
prediction2 <- predict(fit_knn2, prem_data)
pred2 <- prem_data %>%
mutate(PredictedClass = prediction2$.pred_class) %>%
select(Game.Week, home_team_name, away_team_name, PredictedClass) %>%
filter(Game.Week == 8)
pred2
